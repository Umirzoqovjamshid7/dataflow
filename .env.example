# Copy to .env on the server. Never commit .env.
ENVIRONMENT=production
POSTGRES_PASSWORD=
# URL-encode the password in this DSN; Compose database hostname is db.
DATABASE_URL=postgresql+psycopg2://leadflow:GENERATED_PASSWORD@db:5432/leadflow
JWT_SECRET=
CORS_ORIGINS=https://kassa.192-255-242-92.sslip.io
# Generate once on the current server using Fernet.generate_key(); retain securely.
# Required for customers to configure integrations. Never reuse JWT_SECRET here.
INTEGRATION_ENCRYPTION_KEY=
META_GRAPH_VERSION=v23.0
